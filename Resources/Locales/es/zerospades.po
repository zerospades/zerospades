#: Sources/Gui/UI/Settings/PreferencePanels.cpp:145
msgctxt "Preferences"
msgid "Classic Viewmodel"
msgstr "Modelo clásico del arma"

#: Sources/Gui/UI/Settings/PreferencePanels.cpp:147
msgctxt "Preferences"
msgid ""
"Uses the original `AoS 0.75` first-person weapon positions and animations "
"instead of the new ones."
msgstr ""
"Utiliza las posiciones y animaciones originales de las armas en primera "
"persona de `AoS 0.75` en lugar de las nuevas."


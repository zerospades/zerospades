get_filename_component(REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${REPO_ROOT}/Sources/AngelScript/projects/cmake/AndroidCallSources.cmake")

function(check_abi abi expected)
    angelscript_android_call_sources("${abi}" actual)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${abi}: expected '${expected}', got '${actual}'")
    endif()
    foreach(source IN LISTS actual)
        if(NOT EXISTS "${REPO_ROOT}/Sources/AngelScript/projects/cmake/${source}")
            message(FATAL_ERROR "${abi}: selected file does not exist: ${source}")
        endif()
    endforeach()
endfunction()

check_abi("arm64-v8a" "../../source/as_callfunc_arm64.cpp;../../source/as_callfunc_arm64_gcc.S")
check_abi("armeabi-v7a" "../../source/as_callfunc_arm.cpp;../../source/as_callfunc_arm_gcc.S")
check_abi("x86" "")
check_abi("x86_64" "")
message(STATUS "Android ABI selection passed")

# Dependencies must be built for the same NDK ABI before configuring the game.
# Pass -DANDROID_DEPENDENCY_ROOT=<prefix> containing their CMake package files.
if(NOT ANDROID_DEPENDENCY_ROOT OR NOT IS_DIRECTORY "${ANDROID_DEPENDENCY_ROOT}")
    message(FATAL_ERROR "Set ANDROID_DEPENDENCY_ROOT to the Android ABI dependency prefix")
endif()
list(INSERT CMAKE_PREFIX_PATH 0 "${ANDROID_DEPENDENCY_ROOT}")
list(INSERT CMAKE_FIND_ROOT_PATH 0 "${ANDROID_DEPENDENCY_ROOT}")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

find_package(SDL2 CONFIG REQUIRED)
find_package(SDL2_image CONFIG REQUIRED)
find_package(CURL CONFIG REQUIRED)
find_package(ZLIB REQUIRED)
find_package(PNG REQUIRED)
find_package(BZip2 REQUIRED)
# The vcpkg config target carries transitive static dependencies; the built-in
# FindFreetype target alone does not without the vcpkg toolchain wrapper.
find_package(Freetype CONFIG REQUIRED)
find_package(Ogg CONFIG REQUIRED)
find_package(Opus CONFIG REQUIRED)
find_package(OpusFile CONFIG QUIET)

if(TARGET SDL2::SDL2-static)
    set(SDL2_LIBRARY SDL2::SDL2-static)
elseif(TARGET SDL2::SDL2)
    set(SDL2_LIBRARY SDL2::SDL2)
else()
    message(FATAL_ERROR "SDL2 package has no SDL2 target")
endif()
if(TARGET SDL2_image::SDL2_image-static)
    set(SDL2_IMAGE_LIBRARY SDL2_image::SDL2_image-static)
elseif(TARGET SDL2_image::SDL2_image)
    set(SDL2_IMAGE_LIBRARY SDL2_image::SDL2_image)
else()
    message(FATAL_ERROR "SDL2_image package has no SDL2_image target")
endif()
set(CURL_LIBRARY CURL::libcurl)
set(FREETYPE_LIBRARIES Freetype::Freetype)
set(ZLIB_LIBRARIES ZLIB::ZLIB)
set(Ogg_LIBRARY Ogg::ogg)
if(TARGET OpusFile::opusfile)
    set(OpusFile_LIBRARY OpusFile::opusfile)
else()
    find_library(OpusFile_LIBRARY NAMES opusfile)
    if(NOT OpusFile_LIBRARY)
        message(FATAL_ERROR "OpusFile library not found in Android dependencies")
    endif()
endif()
set(SDL2_INCLUDE_DIR "${ANDROID_DEPENDENCY_ROOT}/include/SDL2")
set(SDL2_IMAGE_INCLUDE_DIR "${ANDROID_DEPENDENCY_ROOT}/include/SDL2")
set(OpusFile_INCLUDE_DIR "${ANDROID_DEPENDENCY_ROOT}/include/opus")
set(Opus_INCLUDE_DIR "${ANDROID_DEPENDENCY_ROOT}/include")
set(Ogg_INCLUDE_DIR "${ANDROID_DEPENDENCY_ROOT}/include")

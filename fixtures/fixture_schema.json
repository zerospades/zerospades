{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "ZeroSpades golden-spec fixture envelope v1.1.0. Coordinate convention: Z=0 sky, Z=63 water, AoS left-handed.",
    "title": "ZeroSpades Fixture",
    "type": "object",
    "required": [
        "version",
        "id",
        "behavior",
        "seed",
        "protocol_version",
        "map",
        "inputs",
        "kind",
        "expected"
    ],
    "properties": {
        "version": {
            "type": "string",
            "const": "1.1.0"
        },
        "id": {
            "type": "string",
            "pattern": "^(proto|phys|map|weap|mode)_"
        },
        "subsystem": {
            "type": "string",
            "enum": ["proto", "phys", "map", "weap", "mode"]
        },
        "behavior": {
            "type": "string",
            "enum": ["protocol_compat", "implementation_detail", "known_bug_do_not_preserve"]
        },
        "seed": {
            "type": "integer",
            "minimum": 0
        },
        "protocol_version": {
            "type": "string",
            "enum": ["0.75", "0.76"]
        },
        "map": {
            "type": "object",
            "required": ["generator"],
            "properties": {
                "generator": {
                    "type": "string",
                    "enum": ["flat"]
                },
                "ground_z": {
                    "type": "integer"
                },
                "content_hash": {
                    "type": "string"
                }
            }
        },
        "inputs": {
            "type": "array"
        },
        "api": {
            "$comment": "PORT-04 (D-11): optional structured engine-operation block exercised by value_lookup fixtures. NOT in the top-level required[] — non-value_lookup fixtures (and current empty value_lookups) omit it. 'op' is an OPEN dotted string (e.g. map.castRay, physics.getEyePosition); the closed op registry lives in CONTRACT.md, not the schema, so adding ops across phases does not churn the schema.",
            "type": "object",
            "required": ["op", "args"],
            "properties": {
                "op": {
                    "type": "string"
                },
                "args": {
                    "type": "object"
                }
            }
        },
        "config": {
            "$comment": "PORT-04 (D-09/D-10): formalized additively. No required keys — zero fixtures carry a config block today (A2 VERIFIED), so any formalization is forward-only and Phase 12 populates it. Descriptive optional spawn/setup fields; additional properties tolerated.",
            "type": "object",
            "properties": {
                "spawn": {
                    "type": "object"
                },
                "players": {
                    "type": "array"
                },
                "time_limit_s": {
                    "type": "number"
                }
            }
        },
        "tolerances": {
            "type": "object",
            "properties": {
                "position": {
                    "type": "number"
                },
                "orientation": {
                    "type": "number"
                },
                "grenade": {
                    "type": "number"
                },
                "raycast": {
                    "type": "number"
                }
            }
        },
        "kind": {
            "type": "string",
            "enum": ["world_snapshot", "step_trace", "value_lookup", "packet_roundtrip"]
        },
        "expected": {
            "type": "object"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "world_snapshot"
                    }
                },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "$comment": "PORT-04 (D-09): world_snapshot inputs are OPTIONALLY a packet byte sequence folded to produce the snapshot. No array-minimum constraint (Pitfall 1): 4 of 6 world_snapshots carry bytes_hex packet records, 2 (mode_world_snapshot_ctf/tc) are inputs:[] directly-constructed states — both must validate. Phase 12 embeds setup for the empty ones.",
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/PacketInput"
                        }
                    },
                    "expected": {
                        "type": "object",
                        "$comment": "map_content_hash is OPTIONAL (not in required): snapshots may omit it, matching the Rust WorldSnapshot map_content_hash: Option<String>. Keeping the Python validator and rust_smoke gates in agreement is required for the portability proof (CR-02).",
                        "required": ["tick", "players"],
                        "properties": {
                            "tick": {
                                "type": "integer"
                            },
                            "world_time_s": {
                                "type": "number"
                            },
                            "map_content_hash": {
                                "type": "string"
                            },
                            "players": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/PlayerSnapshot"
                                }
                            },
                            "grenades": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/GrenadeSnapshot"
                                }
                            },
                            "game_mode": {
                                "$ref": "#/$defs/GameModeSnapshot"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "step_trace"
                    }
                },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "$comment": "PORT-04 (D-09): step_trace inputs are a per-tick input schedule (the schedule currently trapped in C++ test code). No array-minimum constraint (Pitfall 1): the 18 step_trace fixtures are all inputs:[] today; Phase 12 populates the per-tick records.",
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/StepTraceInput"
                        }
                    },
                    "expected": {
                        "type": "object",
                        "required": ["ticks"],
                        "properties": {
                            "ticks": {
                                "type": "array"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "value_lookup"
                    }
                },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "$comment": "PORT-04 (D-09): value_lookup is driven by the top-level api block (op + args), so inputs is a permissive array (typically empty). No array-minimum constraint (Pitfall 1).",
                        "type": "array"
                    },
                    "expected": {
                        "type": "object",
                        "required": ["value"]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "packet_roundtrip"
                    }
                },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "inputs": {
                        "$comment": "PORT-04 (D-09): packet_roundtrip has no driving inputs — the expected.bytes_hex IS the stimulus (decode -> expected.decoded; re-encode -> bytes). inputs is a permissive array (always empty). No array-minimum constraint (Pitfall 1).",
                        "type": "array"
                    },
                    "expected": {
                        "type": "object",
                        "required": ["bytes_hex", "decoded"],
                        "properties": {
                            "bytes_hex": {
                                "type": "string"
                            },
                            "decoded": {
                                "type": "object"
                            }
                        }
                    }
                }
            }
        }
    ],
    "$defs": {
        "Vec3": {
            "type": "object",
            "required": ["x", "y", "z"],
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                },
                "z": {
                    "type": "number"
                }
            }
        },
        "StepTraceInput": {
            "$comment": "PORT-04 (D-09/D-10): per-tick input record for step_trace fixtures. Descriptive Rust-friendly fields, ALL optional (NO required[]) so the array's items constraint is satisfied vacuously by today's inputs:[] fixtures and Phase 12 can populate any subset. Additional properties tolerated for forward-compat.",
            "type": "object",
            "properties": {
                "tick": {
                    "type": "integer",
                    "minimum": 0
                },
                "move_forward": {
                    "type": "boolean"
                },
                "move_back": {
                    "type": "boolean"
                },
                "move_left": {
                    "type": "boolean"
                },
                "move_right": {
                    "type": "boolean"
                },
                "jump": {
                    "type": "boolean"
                },
                "crouch": {
                    "type": "boolean"
                },
                "sprint": {
                    "type": "boolean"
                },
                "sneak": {
                    "type": "boolean"
                },
                "primary_fire": {
                    "type": "boolean"
                },
                "secondary_fire": {
                    "type": "boolean"
                },
                "reload": {
                    "type": "boolean"
                },
                "orientation": {
                    "$ref": "#/$defs/Vec3"
                }
            }
        },
        "PacketInput": {
            "$comment": "PORT-04 (D-09): a packet record in a world_snapshot input sequence. bytes_hex is the wire-encoded packet (optional so a non-bytes input form stays permissive); comment is documentation. NO required[] so inputs:[] world_snapshots validate vacuously; additional properties tolerated.",
            "type": "object",
            "properties": {
                "bytes_hex": {
                    "type": "string"
                },
                "comment": {
                    "type": "string"
                }
            }
        },
        "PlayerSnapshot": {
            "type": "object",
            "required": [
                "id",
                "alive",
                "position",
                "velocity",
                "orientation",
                "health",
                "tool",
                "weapon_type"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "alive": {
                    "type": "boolean"
                },
                "position": {
                    "$ref": "#/$defs/Vec3"
                },
                "velocity": {
                    "$ref": "#/$defs/Vec3"
                },
                "orientation": {
                    "$ref": "#/$defs/Vec3"
                },
                "health": {
                    "type": "integer"
                },
                "tool": {
                    "type": "string",
                    "enum": ["spade", "block", "weapon", "grenade"]
                },
                "weapon_type": {
                    "type": "string",
                    "enum": ["rifle", "smg", "shotgun"]
                },
                "team_id": {
                    "type": "integer"
                },
                "grenades": {
                    "type": "integer"
                },
                "blocks": {
                    "type": "integer"
                },
                "airborne": {
                    "type": "boolean"
                },
                "wade": {
                    "type": "boolean"
                },
                "ammo": {
                    "type": "integer"
                },
                "stock": {
                    "type": "integer"
                },
                "is_reloading": {
                    "type": "boolean"
                }
            }
        },
        "GrenadeSnapshot": {
            "type": "object",
            "required": ["position", "velocity", "fuse_s"],
            "properties": {
                "position": {
                    "$ref": "#/$defs/Vec3"
                },
                "velocity": {
                    "$ref": "#/$defs/Vec3"
                },
                "fuse_s": {
                    "type": "number"
                }
            }
        },
        "GameModeSnapshot": {
            "type": "object",
            "required": ["mode"],
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["ctf", "tc"]
                }
            }
        }
    }
}
